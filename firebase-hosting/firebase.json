{
  "hosting": {
    "public": "public",
    "headers": [
      {
        "source": "/levels/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
    
  }
}